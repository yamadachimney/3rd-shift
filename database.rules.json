{
  "rules": {
    ".read": false,
    ".write": false,
    "staff": {
      ".read": "auth != null",
      ".write": "auth != null && auth.token.email === 'owner@rd-shift.example'",
      "$sid": {
        ".validate": "newData.hasChildren(['name','ord'])",
        "name": {
          ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 20"
        },
        "ord": {
          ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 999"
        },
        "off": {
          ".validate": "newData.val() === true"
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "joins": {
      ".read": "auth != null && auth.token.email === 'owner@rd-shift.example'",
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "(auth != null && auth.token.email === 'owner@rd-shift.example') || (auth != null && auth.uid === $uid && (!newData.exists() || root.child('staff/'+newData.child('sid').val()).exists()))",
        ".validate": "newData.hasChildren(['sid','at'])",
        "sid": {
          ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 40"
        },
        "at": {
          ".validate": "newData.isNumber()"
        },
        "dev": {
          ".validate": "newData.isString() && newData.val().length >= 0 && newData.val().length <= 40"
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "members": {
      ".read": "auth != null && auth.token.email === 'owner@rd-shift.example'",
      ".write": "auth != null && auth.token.email === 'owner@rd-shift.example'",
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".validate": "newData.isString() && root.child('staff/'+newData.val()).exists()"
      }
    },
    "periods": {
      ".read": "(auth != null && auth.token.email === 'owner@rd-shift.example') || (auth != null && root.child('members/'+auth.uid).exists())",
      ".write": "auth != null && auth.token.email === 'owner@rd-shift.example'",
      "$pid": {
        ".validate": "newData.hasChildren(['start','end','phase','open','need'])",
        "start": {
          ".validate": "newData.isString() && newData.val().matches(/^[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]$/)"
        },
        "end": {
          ".validate": "newData.isString() && newData.val().matches(/^[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]$/)"
        },
        "deadline": {
          ".validate": "newData.isString() && newData.val().matches(/^[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]$/)"
        },
        "phase": {
          ".validate": "newData.val() === 'closed' || newData.val() === 'request' || newData.val() === 'making' || newData.val() === 'fixed'"
        },
        "open": {
          ".validate": "newData.isNumber() && newData.val() >= 1020 && newData.val() <= 1800"
        },
        "need": {
          ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 20"
        },
        "name": {
          ".validate": "newData.isString() && newData.val().length >= 0 && newData.val().length <= 30"
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "wishes": {
      ".read": "auth != null && auth.token.email === 'owner@rd-shift.example'",
      ".write": "auth != null && auth.token.email === 'owner@rd-shift.example'",
      "$pid": {
        "$sid": {
          ".read": "(auth != null && root.child('members/'+auth.uid).exists()) && root.child('members/'+auth.uid).val() === $sid",
          ".write": "auth != null && root.child('members/'+auth.uid).val() === $sid && root.child('periods/'+$pid+'/phase').val() === 'request'",
          ".validate": "newData.hasChildren(['at'])",
          "at": {
            ".validate": "newData.isNumber()"
          },
          "note": {
            ".validate": "newData.isString() && newData.val().length >= 0 && newData.val().length <= 300"
          },
          "days": {
            "$d": {
              ".validate": "$d.matches(/^[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]$/) && newData.hasChildren(['k']) && (newData.child('k').val() === 'ng' || newData.hasChildren(['s','e']))",
              "k": {
                ".validate": "newData.val() === 'ok' || newData.val() === 'mb' || newData.val() === 'ng'"
              },
              "s": {
                ".validate": "newData.isNumber() && (newData.val() >= 1020 && newData.val() <= 1800 || newData.val() === 9999)"
              },
              "e": {
                ".validate": "newData.isNumber() && (newData.val() >= 1020 && newData.val() <= 1800 || newData.val() === 9999)"
              },
              "$other": {
                ".validate": false
              }
            }
          },
          "$other": {
            ".validate": false
          }
        }
      }
    },
    "shifts": {
      ".write": "auth != null && auth.token.email === 'owner@rd-shift.example'",
      "$pid": {
        ".read": "(auth != null && auth.token.email === 'owner@rd-shift.example') || ((auth != null && root.child('members/'+auth.uid).exists()) && root.child('periods/'+$pid+'/phase').val() === 'fixed')",
        "$d": {
          ".validate": "$d.matches(/^[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]$/)",
          "$sid": {
            ".validate": "newData.hasChildren(['s','e'])",
            "s": {
              ".validate": "newData.isNumber() && (newData.val() >= 1020 && newData.val() <= 1800 || newData.val() === 9999)"
            },
            "e": {
              ".validate": "newData.isNumber() && (newData.val() >= 1020 && newData.val() <= 1800 || newData.val() === 9999)"
            },
            "$other": {
              ".validate": false
            }
          }
        }
      }
    },
    "events": {
      ".read": "(auth != null && auth.token.email === 'owner@rd-shift.example') || (auth != null && root.child('members/'+auth.uid).exists())",
      "$e": {
        ".write": "(auth != null && auth.token.email === 'owner@rd-shift.example') || ((auth != null && root.child('members/'+auth.uid).exists()) && ((!data.exists() && newData.child('uid').val() === auth.uid) || (data.exists() && data.child('uid').val() === auth.uid && (!newData.exists() || newData.child('uid').val() === auth.uid))))",
        ".validate": "newData.hasChildren(['uid','name','start','end','createdAt'])",
        "uid": {
          ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 128"
        },
        "name": {
          ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 30"
        },
        "start": {
          ".validate": "newData.isString() && newData.val().matches(/^[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]$/)"
        },
        "end": {
          ".validate": "newData.isString() && newData.val().matches(/^[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]$/)"
        },
        "note": {
          ".validate": "newData.isString() && newData.val().length >= 0 && newData.val().length <= 200"
        },
        "who": {
          ".validate": "newData.isString() && newData.val().length >= 0 && newData.val().length <= 20"
        },
        "createdAt": {
          ".validate": "newData.isNumber()"
        },
        "need": {
          ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 20 && ((auth != null && auth.token.email === 'owner@rd-shift.example') || newData.val() === data.val())"
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "notify": {
      ".read": "auth != null && auth.token.email === 'owner@rd-shift.example'",
      ".write": "auth != null && auth.token.email === 'owner@rd-shift.example'",
      "$pid": {
        "$sid": {
          "$d": {
            ".validate": "newData.hasChildren(['b','a'])",
            "b": {
              ".validate": "newData.isString() && newData.val().length >= 0 && newData.val().length <= 40"
            },
            "a": {
              ".validate": "newData.isString() && newData.val().length >= 0 && newData.val().length <= 40"
            },
            "$other": {
              ".validate": false
            }
          }
        }
      }
    },
    "supplies": {
      ".read": "(auth != null && auth.token.email === 'owner@rd-shift.example') || (auth != null && root.child('members/'+auth.uid).exists())",
      "$s": {
        ".write": "auth != null && ((auth != null && auth.token.email === 'owner@rd-shift.example') || ((auth != null && root.child('members/'+auth.uid).exists()) && ((!data.exists() && newData.child('uid').val() === auth.uid && newData.child('status').val() === 'new') || (data.exists() && !newData.exists() && data.child('uid').val() === auth.uid && data.child('status').val() === 'new'))))",
        ".validate": "newData.hasChildren(['uid','item','status','createdAt'])",
        "uid": {
          ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 128"
        },
        "item": {
          ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 60"
        },
        "note": {
          ".validate": "newData.isString() && newData.val().length >= 0 && newData.val().length <= 300"
        },
        "who": {
          ".validate": "newData.isString() && newData.val().length >= 0 && newData.val().length <= 20"
        },
        "createdAt": {
          ".validate": "newData.isNumber()"
        },
        "status": {
          ".validate": "newData.val() === 'new' || newData.val() === 'seen' || newData.val() === 'ordered' || newData.val() === 'done'"
        },
        "$other": {
          ".validate": false
        }
      }
    }
  }
}
